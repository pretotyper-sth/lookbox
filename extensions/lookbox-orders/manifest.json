{
  "manifest_version": 3,
  "name": "RealCloset 구매내역",
  "version": "0.3.0",
  "description": "로그인된 크롬에서 쇼핑몰 주문내역을 읽어 RealCloset 옷장에 담습니다.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "https://*/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "https://lookbox.vercel.app/*",
        "https://realcloset.vercel.app/*"
      ],
      "js": ["lookbox-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "RealCloset 구매내역",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
