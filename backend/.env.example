OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
# optional override for classify only (default = OPENAI_VISION_MODEL)
# OPENAI_CLASSIFY_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
# 인쇄 텍스트/로고 감지 시에만 사용 (기본 gpt-image-2)
# OPENAI_IMAGE_MODEL_TEXT=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
# OPENAI_IMAGE_QUALITY_TEXT=high

# UX/UI 테스트 무비용 모드: 1이면 OpenAI(vision/image) 호출을 전부 건너뛰고
# 로컬 폴백(분류 기본값·추천 폴백·PIL 컷아웃/콜라주)만 사용해 과금 $0.
# AI_TEST_MODE=1

# 착장 품질 테스트: 1이면 착장 이미지를 최대 1장만 만든다. 0이면 제한 없음.
LOOK_TEST_LIMIT=1

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=wardrobe

FRONTEND_ORIGINS=http://localhost:5173,https://lookbox.vercel.app,https://realcloset.vercel.app
DEFAULT_IMAGE_CREDITS=25
APP_ENV=production
